<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#112918">
  <title>{{title}} · Over There</title>
  <meta name="description" content="Discover and share GPX routes for cycling. Follow the line, know the ride.">
  {{#if canonical}}<link rel="canonical" href="{{canonical}}"><meta property="og:url" content="{{canonical}}">{{/if}}
  <meta property="og:title" content="{{title}} · Over There">
  <meta property="og:description" content="Explore this cycling route with an interactive map, route details and GPX download.">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
  {{#if page_route}}<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@6.15.0/dist/maplibre-gl.css">{{/if}}
</head>
<body class="{{#if page_home}}home-body{{else}}app-body{{/if}}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Over There home"><span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M3 25 11 7l6 15 5-10 7 13"/></svg></span><span>Over There</span></a>
    <nav aria-label="Main navigation"><a href="/explore" {{#if page_explore}}aria-current="page"{{/if}}>Explore</a><a href="/upload" {{#if page_upload}}aria-current="page"{{/if}}>Share a route</a>{{#if user}}<a href="/dashboard" {{#if page_dashboard}}aria-current="page"{{/if}}>Dashboard</a>{{/if}}</nav>
    <div class="header-account">{{#if user}}<a href="/account" class="account-link">{{user.username}}</a>{{else}}<a href="/login">Sign in</a><a class="header-join" href="/register">Join</a>{{/if}}</div>
  </header>
  <main id="main">
  {{#if page_home}}
  <section class="hero">
    <div class="hero-copy"><h1>Go a little further.</h1><p>Routes worth riding, shared by cyclists. See the line, know the terrain, and download the GPX.</p><div class="hero-actions"><a class="button button-light" href="/explore">Explore routes <span aria-hidden="true">↗</span></a><a class="text-action" href="/upload">Share your route</a></div></div>
    <div class="route-sheet" aria-label="A route field note"><div class="sheet-top"><span>Field notes for the open road</span><span>GPX / Cycling</span></div><div class="sheet-art"><svg viewBox="0 0 480 500" role="img" aria-label="Illustrated route trace"><path class="sheet-contour" d="M-50 70 C90 5 145 180 330 40 S520 70 530 80 M-50 140 C90 75 145 250 330 110 S520 140 530 150 M-50 210 C90 145 145 320 330 180 S520 210 530 220 M-50 280 C90 215 145 390 330 250 S520 280 530 290 M-50 350 C90 285 145 460 330 320 S520 350 530 360 M-50 420 C90 355 145 530 330 390 S520 420 530 430"/><path class="sheet-route" d="M94 354 C75 301 130 259 181 279 C239 301 262 207 224 174 C196 145 247 93 308 119 C340 132 325 202 374 192 C418 184 391 304 351 343 C295 398 205 348 174 393"/><circle cx="94" cy="354" r="9"/><circle cx="174" cy="393" r="9"/></svg></div><div class="sheet-bottom"><strong>Find the line.<br>Ride your own way.</strong><span>Curated by riders,<br>open to everyone.</span></div></div>
  </section>
  <section class="home-latest"><div class="section-heading"><h2>Fresh from the road</h2><a href="/explore">View every route <span aria-hidden="true">↗</span></a></div>
    {{#if routes}}<div class="route-grid">{{#each routes}}<a class="route-card" href="/routes/{{slug}}"><div class="route-preview">{{#if cover}}<img src="{{cover}}" alt="Cover for {{title}}" loading="lazy">{{else}}{{{preview}}}{{/if}}</div><div class="route-card-copy"><span class="route-place">{{region}}, {{country}}</span><h3>{{title}}</h3><p>{{distance_km}} km <span>·</span> {{cycling_type}} {{#if gain}}<span>·</span> ↑ {{gain}} m{{/if}}</p></div></a>{{/each}}</div>{{else}}<div class="empty-home"><p>The map is open. Be the first to put a route on it.</p><a class="button" href="/upload">Share a GPX</a></div>{{/if}}
  </section>
  <section class="home-process"><div><h2>From your ride<br>to theirs.</h2><p>Upload the GPX you already have. We read the distance and elevation, you add the local knowledge. Others can explore it on a map and download the file.</p></div><div class="process-slip"><div><span>Bring a GPX</span><span>Any ride you can share</span></div><div><span>Review the route</span><span>Control what is public</span></div><div><span>Put it out there</span><span>Ready to download</span></div><strong>One route. More roads to ride.</strong></div></section>
  <a class="home-cta" href="/upload"><span>Have a line worth sharing?</span><strong>Share.</strong><span class="cta-arrow" aria-hidden="true">↗</span></a>
  {{/if}}

  {{#if page_explore}}
  <div class="app-frame"><div class="app-sheet explore-sheet"><div class="page-heading"><div><h1>Explore routes</h1><p>Find a ride that fits your day.</p></div><span class="result-count">{{count}} routes</span></div>
    <form class="filter-form" method="get" action="/explore"><label>Route name<input name="q" type="search" value="{{filters.q}}" placeholder="Search routes"></label><label>Region<input name="region" value="{{filters.region}}" placeholder="City or region"></label><label>Cycling type<select name="cycling_type"><option value="">All types</option><option value="road" {{#if (eq filters.cycling_type "road")}}selected{{/if}}>Road</option><option value="gravel" {{#if (eq filters.cycling_type "gravel")}}selected{{/if}}>Gravel</option><option value="mountain" {{#if (eq filters.cycling_type "mountain")}}selected{{/if}}>Mountain</option><option value="touring" {{#if (eq filters.cycling_type "touring")}}selected{{/if}}>Touring</option><option value="bikepacking" {{#if (eq filters.cycling_type "bikepacking")}}selected{{/if}}>Bikepacking</option><option value="urban" {{#if (eq filters.cycling_type "urban")}}selected{{/if}}>Urban</option><option value="mixed" {{#if (eq filters.cycling_type "mixed")}}selected{{/if}}>Mixed</option></select></label><label>Difficulty<select name="difficulty"><option value="">Any difficulty</option><option value="easy" {{#if (eq filters.difficulty "easy")}}selected{{/if}}>Easy</option><option value="moderate" {{#if (eq filters.difficulty "moderate")}}selected{{/if}}>Moderate</option><option value="hard" {{#if (eq filters.difficulty "hard")}}selected{{/if}}>Hard</option></select></label><label>Min km<input name="min_km" type="number" min="0" value="{{filters.min_km}}"></label><label>Max km<input name="max_km" type="number" min="0" value="{{filters.max_km}}"></label><label>Sort<select name="sort"><option value="newest">Newest</option><option value="popular" {{#if filters.popular}}selected{{/if}}>Most downloaded</option></select></label><button class="button" type="submit">Find routes</button></form>
    {{#if routes}}<div class="route-grid">{{#each routes}}<a class="route-card" href="/routes/{{slug}}"><div class="route-preview">{{#if cover}}<img src="{{cover}}" alt="Cover for {{title}}" loading="lazy">{{else}}{{{preview}}}{{/if}}</div><div class="route-card-copy"><span class="route-place">{{region}}, {{country}}</span><h2>{{title}}</h2><p>{{distance_km}} km <span>·</span> {{cycling_type}} {{#if gain}}<span>·</span> ↑ {{gain}} m{{/if}}</p></div></a>{{/each}}</div>{{else}}<div class="empty-state"><h2>No routes found</h2><p>Try a broader search, or share a route from this area.</p><a href="/upload">Share a route</a></div>{{/if}}
    <nav class="pagination" aria-label="Pages">{{#if has_prev}}<a href="?q={{filters.q}}&region={{filters.region}}&cycling_type={{filters.cycling_type}}&difficulty={{filters.difficulty}}&page={{prev_page}}">← Previous</a>{{/if}}<span>Page {{page_number}}</span>{{#if has_next}}<a href="?q={{filters.q}}&region={{filters.region}}&cycling_type={{filters.cycling_type}}&difficulty={{filters.difficulty}}&page={{next_page}}">Next →</a>{{/if}}</nav>
  </div></div>
  {{/if}}

  {{#if page_route}}
  <div class="route-layout"><div class="route-main"><div class="route-map" id="route-map" data-slug="{{route.slug}}" data-style="{{map_style}}"><div class="map-fallback">Loading the route map…</div></div><div class="route-body"><div class="route-intro"><div><p class="route-place">{{route.region}}, {{route.country}} · {{route.cycling_type}}</p><h1>{{route.title}}</h1><p>{{route.description}}</p></div><div class="route-actions"><a class="button" href="/routes/{{route.slug}}/download">Download GPX</a><button class="button button-outline" type="button" id="share-route">Share route</button></div></div><div class="metric-strip"><div><strong>{{route.distance_km}}</strong><span>km distance</span></div><div><strong>{{#if route.gain}}{{route.gain}}{{else}}—{{/if}}</strong><span>m ascent</span></div><div><strong>{{#if route.duration}}{{route.duration}}{{else}}—{{/if}}</strong><span>duration</span></div><div><strong>{{route.difficulty}}</strong><span>difficulty</span></div></div>
    {{#if elevation_json}}<section class="elevation-section"><h2>Elevation</h2><div id="elevation-chart" data-points="{{elevation_json}}" aria-label="Elevation profile"></div><p>Move along the chart to locate a point on the map.</p></section>{{/if}}
    {{#if photos}}<section class="route-photos"><h2>Along the way</h2><div class="photo-grid">{{#each photos}}<img src="{{this}}" alt="Photo shared with this route" loading="lazy">{{/each}}</div></section>{{/if}}
    <section class="route-attribution"><h2>Shared by</h2><a class="author-line" href="/users/{{author.username}}">{{#if author.avatar}}<img src="/users/{{author.username}}/avatar" alt="" width="44" height="44">{{else}}<span class="avatar-letter">{{author.username}}</span>{{/if}}<span>{{author.username}} {{#if author.verified}}<span class="verified-badge" title="Verified contributor">Verified contributor</span>{{/if}}</span></a>{{#if route.endpoint_hidden}}<p class="privacy-note">The shared route hides points near its start and finish. The downloadable GPX is also redacted for visitors.</p>{{/if}}{{#if can_edit}}<p><a href="/routes/{{route.slug}}/edit">Edit this route</a></p>{{/if}}</section>
    <details class="report-panel"><summary>Report a problem with this route</summary><form method="post" action="/routes/{{route.slug}}/report"><input type="hidden" name="csrf" value="{{csrf}}"><label>Reason<select name="reason" required><option value="misleading">Misleading information</option><option value="copyright">Copyright concern</option><option value="unsafe">Unsafe content</option><option value="other">Other</option></select></label><label>Details<textarea name="details" rows="3" maxlength="1000"></textarea></label><button class="button button-outline" type="submit">Send report</button></form></details>
  </div></div><aside class="route-side"><p class="route-side-heading">Route notes</p><div><strong>{{route.distance_km}} km</strong><span>{{route.cycling_type}} · {{route.difficulty}}</span></div><div><strong>{{route.region}}</strong><span>{{route.country}}</span></div><div><strong>{{route.downloads}}</strong><span>downloads</span></div><a href="/routes/{{route.slug}}/download" class="button">Download GPX <span aria-hidden="true">↓</span></a></aside></div>
  <script src="https://unpkg.com/maplibre-gl@6.15.0/dist/maplibre-gl.js" defer></script><script src="/static/route.js" defer></script>
  {{/if}}

  {{#if page_profile}}<div class="app-frame"><div class="app-sheet"><div class="profile-head">{{#if profile.avatar}}<img src="/users/{{profile.username}}/avatar" alt="" width="96" height="96">{{else}}<span class="profile-avatar">{{profile.username}}</span>{{/if}}<div><h1>{{profile.username}} {{#if profile.verified}}<span class="verified-badge">Verified contributor</span>{{/if}}</h1><p>{{profile.bio}}</p><span>{{profile.count}} public routes</span></div></div><h2 class="list-heading">Routes from {{profile.username}}</h2>{{#if routes}}<div class="route-grid">{{#each routes}}<a class="route-card" href="/routes/{{slug}}"><div class="route-preview">{{#if cover}}<img src="{{cover}}" alt="Cover for {{title}}" loading="lazy">{{else}}{{{preview}}}{{/if}}</div><div class="route-card-copy"><span class="route-place">{{region}}, {{country}}</span><h3>{{title}}</h3><p>{{distance_km}} km · {{cycling_type}}</p></div></a>{{/each}}</div>{{else}}<p>No public routes yet.</p>{{/if}}</div></div>{{/if}}

  {{#if page_dashboard}}<div class="app-frame"><div class="app-sheet"><div class="page-heading"><div><h1>Your routes</h1><p>{{#if user.verified}}Everything you have put on the map.{{else}}Check your email to verify your account before sharing a route.{{/if}}</p></div><a class="button" href="/upload">Add route</a></div><div class="dashboard-stats"><div><strong>{{stats.count}}</strong><span>Routes</span></div><div><strong>{{stats.km}}</strong><span>Total km</span></div><div><strong>{{stats.public}}</strong><span>Public</span></div><div><strong>{{stats.private}}</strong><span>Private</span></div><div><strong>{{stats.downloads}}</strong><span>Downloads</span></div></div><h2 class="list-heading">Recently uploaded</h2>{{#if routes}}<div class="route-table"><div class="table-head"><span>Route</span><span>Visibility</span><span>Distance</span><span>Downloads</span><span></span></div>{{#each routes}}<div class="table-row"><a href="/routes/{{slug}}">{{title}}<small>{{region}} · {{cycling_type}}</small></a><span>{{visibility}}</span><span>{{distance_km}} km</span><span>{{downloads}}</span><a href="/routes/{{slug}}/edit">Edit</a></div>{{/each}}</div>{{else}}<div class="empty-state"><h2>Your first route starts here</h2><p>Upload a GPX and add the details that make it useful to another rider.</p><a href="/upload">Share a GPX</a></div>{{/if}}</div></div>{{/if}}

  {{#if page_upload}}<div class="app-frame"><div class="app-sheet form-sheet"><div class="page-heading"><div><h1>Share a route</h1><p>Bring the GPX. Add the story and choose who sees it.</p></div></div>{{#if user.verified}}<form class="route-form" method="post" action="/upload" enctype="multipart/form-data"><input type="hidden" name="csrf" value="{{csrf}}"><div class="form-main"><section><h2>The route file</h2><label>GPX file<input type="file" name="gpx" accept=".gpx,application/gpx+xml,application/xml,text/xml" required></label><p class="field-help">Up to 10 MB. Tracks and route points are supported. Missing elevation or time is fine.</p></section><section><h2>Tell riders about it</h2><label>Title<input name="title" maxlength="100" required placeholder="A route name people will remember"></label><label>Description<textarea name="description" rows="5" maxlength="2000" placeholder="Road conditions, highlights, water stops, anything worth knowing"></textarea></label><div class="field-row"><label>Region<input name="region" required maxlength="80" placeholder="e.g. Taipei"></label><label>Country<input name="country" required maxlength="80" placeholder="e.g. Taiwan"></label></div><div class="field-row"><label>Cycling type<select name="cycling_type"><option value="road">Road cycling</option><option value="gravel">Gravel cycling</option><option value="mountain">Mountain biking</option><option value="touring">Bike touring</option><option value="bikepacking">Bikepacking</option><option value="urban">Urban cycling</option><option value="mixed">Mixed terrain</option></select></label><label>Difficulty<select name="difficulty"><option value="easy">Easy</option><option value="moderate">Moderate</option><option value="hard">Hard</option></select></label></div><label>Tags<input name="tags" maxlength="160" placeholder="riverside, climbing, coffee stop"></label><label>Cover photo (optional)<input type="file" name="cover" accept="image/jpeg,image/png,image/webp"></label><label>Additional photo 1 (optional)<input type="file" name="photo1" accept="image/jpeg,image/png,image/webp"></label><label>Additional photo 2 (optional)<input type="file" name="photo2" accept="image/jpeg,image/png,image/webp"></label><label>Additional photo 3 (optional)<input type="file" name="photo3" accept="image/jpeg,image/png,image/webp"></label></section></div><aside class="form-aside"><h2>Publishing</h2><label>Visibility<select name="visibility"><option value="public">Public — searchable and downloadable</option><option value="unlisted">Unlisted — anyone with the link</option><option value="private">Private — only you</option></select></label><label>Hide route ends<select name="hide_endpoints"><option value="0">Show complete route</option><option value="250">Hide 250 m at each end</option><option value="500">Hide 500 m at each end</option><option value="1000">Hide 1 km at each end</option></select></label><p class="field-help">Endpoint hiding removes nearby points from the public map and visitor GPX. You can still download your original file.</p><button class="button" type="submit">Publish route</button></aside></form>{{else}}<div class="empty-state"><h2>Verify your email first</h2><p>Open the verification link we sent when you registered. Then come back to share your route.</p></div>{{/if}}</div></div>{{/if}}

  {{#if page_edit}}<div class="app-frame"><div class="app-sheet form-sheet"><div class="page-heading"><div><h1>Edit route</h1><p>Update the information riders see.</p></div><a href="/routes/{{route.slug}}">View route</a></div><form class="route-form" method="post" action="/routes/{{route.slug}}/edit"><input type="hidden" name="csrf" value="{{csrf}}"><div class="form-main"><section><label>Title<input name="title" value="{{route.title}}" maxlength="100" required></label><label>Description<textarea name="description" rows="6" maxlength="2000">{{route.description}}</textarea></label><div class="field-row"><label>Region<input name="region" value="{{route.region}}" maxlength="80" required></label><label>Country<input name="country" value="{{route.country}}" maxlength="80" required></label></div><div class="field-row"><label>Cycling type<select name="cycling_type"><option value="road" {{#if (eq route.cycling_type "road")}}selected{{/if}}>Road</option><option value="gravel" {{#if (eq route.cycling_type "gravel")}}selected{{/if}}>Gravel</option><option value="mountain" {{#if (eq route.cycling_type "mountain")}}selected{{/if}}>Mountain</option><option value="touring" {{#if (eq route.cycling_type "touring")}}selected{{/if}}>Touring</option><option value="bikepacking" {{#if (eq route.cycling_type "bikepacking")}}selected{{/if}}>Bikepacking</option><option value="urban" {{#if (eq route.cycling_type "urban")}}selected{{/if}}>Urban</option><option value="mixed" {{#if (eq route.cycling_type "mixed")}}selected{{/if}}>Mixed</option></select></label><label>Difficulty<select name="difficulty"><option value="easy" {{#if (eq route.difficulty "easy")}}selected{{/if}}>Easy</option><option value="moderate" {{#if (eq route.difficulty "moderate")}}selected{{/if}}>Moderate</option><option value="hard" {{#if (eq route.difficulty "hard")}}selected{{/if}}>Hard</option></select></label></div><label>Tags<input name="tags" value="{{route.tags}}" maxlength="160"></label></section></div><aside class="form-aside"><h2>Publishing</h2><label>Visibility<select name="visibility"><option value="public" {{#if (eq route.visibility "public")}}selected{{/if}}>Public</option><option value="unlisted" {{#if (eq route.visibility "unlisted")}}selected{{/if}}>Unlisted</option><option value="private" {{#if (eq route.visibility "private")}}selected{{/if}}>Private</option></select></label><p class="field-help">To change endpoint hiding, upload a new route with the desired setting.</p><button class="button" type="submit">Save changes</button></aside></form><form class="danger-form" method="post" action="/routes/{{route.slug}}/delete" onsubmit="return confirm('Delete this route and its GPX permanently?')"><input type="hidden" name="csrf" value="{{csrf}}"><button type="submit">Delete route</button></form></div></div>{{/if}}

  {{#if page_register}}<div class="auth-shell"><div class="auth-intro"><h1>Put your routes<br>out there.</h1><p>A place for the rides you want others to find.</p></div><form class="auth-form" method="post" action="/register"><h2>Create an account</h2><input type="hidden" name="csrf" value="{{csrf}}"><label>Username<input name="username" autocomplete="username" required minlength="3" maxlength="32" pattern="[a-z0-9_]+"></label><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="new-password" required minlength="12"><small>At least 12 characters.</small></label><button class="button" type="submit">Create account</button><p>Already riding with us? <a href="/login">Sign in</a></p></form></div>{{/if}}
  {{#if page_login}}<div class="auth-shell"><div class="auth-intro"><h1>Welcome back<br>to the road.</h1><p>Your routes are right where you left them.</p></div><form class="auth-form" method="post" action="/login"><h2>Sign in</h2><input type="hidden" name="csrf" value="{{csrf}}"><label>Email<input type="email" name="email" autocomplete="email" required></label><label>Password<input type="password" name="password" autocomplete="current-password" required></label><button class="button" type="submit">Sign in</button><p>New here? <a href="/register">Create an account</a></p></form></div>{{/if}}

  {{#if page_account}}<div class="app-frame"><div class="app-sheet"><div class="page-heading"><div><h1>Account settings</h1><p>Your public profile and account details.</p></div><a href="/users/{{account.username}}">View profile</a></div><div class="settings-layout"><div><h2>Public profile</h2><p>What riders see when they open your profile.</p></div><form method="post" action="/account" enctype="multipart/form-data"><input type="hidden" name="csrf" value="{{csrf}}"><label>Username<input value="{{account.username}}" disabled></label><label>Biography<textarea name="bio" rows="4" maxlength="300">{{account.bio}}</textarea></label><label>Profile picture<input type="file" name="avatar" accept="image/jpeg,image/png,image/webp"></label><button class="button" type="submit">Save profile</button></form><div><h2>Account</h2><p>Verification is separate from a trusted contributor badge.</p></div><div class="settings-info"><p><strong>Email</strong><br>{{account.email}}</p><p><strong>Email verified</strong><br>{{#if account.verified}}Yes{{else}}Not yet — check your inbox{{/if}}</p>{{#unless account.verified}}<form method="post" action="/account/resend-verification"><input type="hidden" name="csrf" value="{{csrf}}"><button class="button button-outline" type="submit">Resend verification link</button></form>{{/unless}}<form method="post" action="/logout"><input type="hidden" name="csrf" value="{{csrf}}"><button class="button button-outline" type="submit">Sign out</button></form></div></div></div></div>{{/if}}

  {{#if page_admin}}<div class="app-frame"><div class="app-sheet"><div class="page-heading"><div><h1>Administration</h1><p>Reports, contributors and platform totals.</p></div></div><div class="dashboard-stats"><div><strong>{{stats.users}}</strong><span>Users</span></div><div><strong>{{stats.routes}}</strong><span>Routes</span></div><div><strong>{{stats.reports}}</strong><span>Open reports</span></div></div><h2 class="list-heading">Route reports</h2>{{#if reports}}<div class="admin-list">{{#each reports}}<div class="admin-row"><div><a href="/routes/{{slug}}">{{title}}</a><p>{{reason}} · {{details}}</p><small>{{status}}</small></div>{{#if open}}<form method="post" action="/admin/reports/{{id}}"><input type="hidden" name="csrf" value="{{../csrf}}"><button name="action" value="dismiss" type="submit">Dismiss</button><button name="action" value="remove" type="submit">Make private</button></form>{{/if}}</div>{{/each}}</div>{{else}}<p>No reports.</p>{{/if}}<h2 class="list-heading">Contributors</h2><div class="admin-list">{{#each users}}<div class="admin-row"><div><a href="/users/{{username}}">{{username}}</a><p>{{email}} · {{#if email_verified}}Email verified{{else}}Email unverified{{/if}}</p></div>{{#if email_verified}}<form method="post" action="/admin/users/{{id}}/contributor"><input type="hidden" name="csrf" value="{{../csrf}}"><button type="submit" name="verified" value="{{#if contributor}}false{{else}}true{{/if}}">{{#if contributor}}Remove badge{{else}}Verify contributor{{/if}}</button></form>{{/if}}</div>{{/each}}</div></div></div>{{/if}}
  </main>
  <footer class="site-footer"><a class="brand" href="/">Over There</a><p>Good routes go further when shared.</p><a href="/explore">Explore routes</a><a href="/upload">Share yours</a>{{#if user.admin}}<a href="/admin">Admin</a>{{/if}}</footer>
  <script src="/static/app.js" defer></script>
</body>
</html>
